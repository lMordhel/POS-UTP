# sales-service — plantilla de variables (SPEC S6). Copiar a .env y ajustar.
# .env NO se versiona; este archivo SÍ. No contiene secretos reales.

# --- Despliegue (sin prefijo) ---
POS_ENV=dev
POS_LOG_LEVEL=INFO

# --- Aplicación (prefijo SALES_) ---
SALES_DATABASE_URL=sqlite:///./sales.db
SALES_API_V1_STR=/api/v1
SALES_STOCK_SERVICE_URL=http://localhost:8002
SALES_STOCK_TIMEOUT_SECONDS=5.0
SALES_JWT_SECRET=change-me-dev-only
SALES_JWT_ALGORITHM=HS256
SALES_ACCESS_TOKEN_MINUTES=15
SALES_REFRESH_TOKEN_DAYS=7
SALES_ADMIN_USERNAME=admin
SALES_ADMIN_PASSWORD=change-me-admin
SALES_CORS_ORIGINS=http://localhost:5173
SALES_RATE_LOGIN=5/minute
SALES_RATE_REFRESH=20/minute
SALES_RATE_WRITE=60/minute
