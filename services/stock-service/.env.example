# stock-service — plantilla de variables (SPEC S6). Copiar a .env y ajustar.
# .env NO se versiona; este archivo SÍ. No contiene secretos reales.

# --- Despliegue (sin prefijo) ---
POS_ENV=dev
POS_LOG_LEVEL=INFO

# --- Aplicación (prefijo STOCK_) ---
STOCK_DATABASE_URL=sqlite:///./stock.db
STOCK_API_V1_STR=/api/v1
STOCK_JWT_SECRET=change-me-dev-only
STOCK_JWT_ALGORITHM=HS256
STOCK_ACCESS_TOKEN_MINUTES=15
STOCK_REFRESH_TOKEN_DAYS=7
STOCK_CORS_ORIGINS=http://localhost:5173
STOCK_RATE_WRITE=60/minute
